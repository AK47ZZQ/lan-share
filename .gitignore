# ---- 运行数据 / 用户文件（data/ 是网盘数据根，含 .meta.db 账号库） ----
/data/
logs/
__pycache__/
*.pyc

# ---- 项目自带环境（2026-09-21 迁移：venv + PG + 构建工具链全部收编进仓库目录） ----
# .venv/ = 专用 Python venv（pip install -r requirements.txt 可重建）
# env/   = pginstall(PG数据+zonky)/pgsql/ffmpeg/flutter/android-sdk —— 含生产数据库，严禁入库
/.venv/
/env/

# ---- Flutter / Android（mobile/）----
# 镜像构建会写入 C:\lan-share-mobile/.gradle 缓存几百 MB；不要进库
mobile/build/
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/android/.gradle/
mobile/android/.idea/
mobile/android/local.properties
mobile/android/app/release/
mobile/ios/Pods/
mobile/ios/Runner.xcworkspace/xcuserdata/
mobile/ios/Runner.xcodeproj/xcuserdata/
# 整库占位
mobile/ios/Flutter/Generated.xcconfig
mobile/ios/Flutter/flutter_export_environment.sh
mobile/.gitignore
# flutter create 脚手架留下的 IDE 文件
mobile/lanshare_app.iml

# ---- Flutter 镜像构建缓存（scripts/build-apk.bat 写到 C:\lan-share-mobile）----
/lan-share-mobile/

# ---- Python 调试产物 ----
.pytest_cache/
.mimosa/
*.egg-info/

# ---- 二进制与证书 ----
# caddy.exe（49MB）不入库，从 https://caddyserver.com/download 下载原生版
caddy.exe
# 自签证书可重新生成（方法见 certs/san.cnf 与 docs/DEVELOPMENT.md），私钥严禁入库
certs/*.pem

# ---- 调试凭据（含明文密码，只留本机） ----
docs/DEBUG-ACCOUNT.md

# ---- 系统杂项 ----
Thumbs.db
desktop.ini
.DS_Store
*.log
*.tmp

# ---- Agent/工具链会话产物（11 号复审批次 0）----
# .workbuddy/ 是 AI 协作工具的项目数据目录（工作记忆），非源码；
# test-reports/ 是测试/审查过程产物。均不入库，避免污染仓库与泄露会话上下文。
.workbuddy/
test-reports/
# Flutter 工具链临时状态
mobile/.flutter_tool_state

# ---- 文档/截图临时文件（测试/审查过程产物）----
screen_*.png
debug_*.png

# 前端构建产物：dist 丢失有 503 维护页兜底，npm run build 可重建；node_modules 绝不入库
web/node_modules/
web/dist/

# ---- App release 签名（丢了就无法覆盖安装，只留本机 + <仓库外的私有备份位置>）----
mobile/android/key.properties
mobile/android/keys/

# E2E 临时截图与 UI dump（AI 实测产物，不入库）
/e2e
/e2e-*.png

# ---- 生产凭据（只留本机，仓库内严禁落盘；参考副本在 <仓库外的私有位置>\） ----
/LAN Share 数据库密码.txt
/mysql.txt

# ZCode 会话本地产物（计划草稿等），不入库
.zcode/

# ---- uv 版本锁（2026-10-30）----
# 项目依赖用 requirements.txt 管（见 AGENTS.md §3），uv.lock 是本地跑 uv 时的产物，
# 只含 version/revision/requires-python 三行，入库会与 requirements.txt 形成两套真相
uv.lock

# ---- 开源前排除：内部记忆 / 教训 / 交接文档（2026-10-30）----
# 这些路径含：真实事故复盘、本机绝对路径（C:\lan-share）、真实邮箱、
# 个人协作偏好与心理状态、调试凭据引用、历史文件清单快照。
# 产品价值（架构决策、接口契约、为什么这么设计）已体现在代码与 README 中；
# 内部复盘保留在私有副本，不进公开历史。
/AGENTS.md
/HANDOFF.md
/.backup-audit/
/docs/_internal/

# 归档目录与运行时二进制（2026-10-30 项目整理）
/_archived-*/

# Caddy 运行时二进制（2026-10-30 移入 bin/）
/bin/

# 改文件前的本地备份（2026-10-30）
*.bak-*

# 安装包构建产物（installer/build.ps1 生成，含 82MB 运行时，绝不入库）
build/

# 安装器端到端测试脚本（由 lanshare.iss 派生，改个端口/服务名/目录用于隔离验证）
installer/lanshare-e2e.iss

# 托盘程序编译产物（installer/tray/build-tray.ps1 生成，csc.exe 几秒钟就能重建）
installer/tray/bin/

# Caddyfile 改写的临时备份（lan enable/disable 时生成，成功后不留）
Caddyfile.lanbak
conf/Caddyfile.lanbak
