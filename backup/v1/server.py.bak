"""
LAN Share — 局域网文件分发服务
FastAPI 后端：目录浏览、文件上传、分享链接、QR 码生成
"""

import hashlib
import mimetypes
import os
import re
import secrets
import shutil
import time
from datetime import datetime, timedelta
from pathlib import Path
from typing import Optional

import aiofiles
import qrcode
import qrcode.image.svg
from fastapi import FastAPI, HTTPException, UploadFile, File, Form, Query, Request
from fastapi.responses import HTMLResponse, FileResponse, JSONResponse, Response
from fastapi.staticfiles import StaticFiles

# ─── 配置 ───────────────────────────────────────────────

SHARE_ROOT = Path(os.environ.get("SHARE_ROOT", "C:/lan-share/data"))
PROJECT_ROOT = Path(__file__).parent
MAX_UPLOAD_SIZE = 2 * 1024 * 1024 * 1024  # 2GB
TMP_MAX_AGE_DAYS = 7
CLEANUP_INTERVAL = 3600  # 1 hour

# 分享令牌存储（内存，重启清空）
share_tokens: dict[str, dict] = {}

app = FastAPI(title="LAN Share", version="1.0.0")


# ─── 工具函数 ─────────────────────────────────────────────

def human_size(size_bytes: int) -> str:
    """1234567 → '1.2 MB'"""
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if size_bytes < 1024:
            return f"{size_bytes:.1f} {unit}" if unit != "B" else f"{size_bytes} B"
        size_bytes /= 1024
    return f"{size_bytes:.1f} PB"


def safe_path(rel: str) -> Path:
    """防目录穿越：确保路径在 SHARE_ROOT 内"""
    try:
        target = (SHARE_ROOT / rel)
        # 用 absolute() 而不是 resolve() —— resolve() 会穿透 junction/symlink
        # 导致 C:\lan-share\data 变成 C:\Users\...\data，跟 SHARE_ROOT 对不上
        target_abs = str(target.absolute())
        root_abs = str(SHARE_ROOT.absolute())
        if not target_abs.startswith(root_abs):
            raise HTTPException(status_code=403, detail="Forbidden")
        return target
    except HTTPException:
        raise
    except Exception:
        raise HTTPException(status_code=400, detail="Invalid path")


def dir_tree(path: Path) -> dict:
    """生成目录树 JSON"""
    items = []
    if not path.exists():
        return {"path": "", "items": []}

    for entry in sorted(path.iterdir(), key=lambda e: (not e.is_dir(), e.name.lower())):
        stat = entry.stat()
        rel = str(entry.relative_to(SHARE_ROOT)).replace("\\", "/")
        items.append({
            "name": entry.name,
            "path": rel,
            "is_dir": entry.is_dir(),
            "size": stat.st_size if entry.is_file() else None,
            "size_human": human_size(stat.st_size) if entry.is_file() else "-",
            "modified": datetime.fromtimestamp(stat.st_mtime).isoformat(),
            "ext": entry.suffix.lower() if entry.is_file() else None,
        })

    rel_path = str(path.relative_to(SHARE_ROOT)).replace("\\", "/")
    return {"path": rel_path if rel_path != "." else "", "items": items}


async def save_upload(file: UploadFile, dest: Path) -> dict:
    """流式保存上传文件"""
    dest.parent.mkdir(parents=True, exist_ok=True)
    size = 0
    sha256 = hashlib.sha256()

    async with aiofiles.open(dest, "wb") as f:
        while chunk := await file.read(1024 * 1024):  # 1MB chunks
            size += len(chunk)
            if size > MAX_UPLOAD_SIZE:
                await f.close()
                dest.unlink(missing_ok=True)
                raise HTTPException(status_code=413, detail=f"File too large (max {human_size(MAX_UPLOAD_SIZE)})")
            sha256.update(chunk)
            await f.write(chunk)

    return {
        "name": file.filename,
        "path": str(dest.relative_to(SHARE_ROOT)).replace("\\", "/"),
        "size": size,
        "size_human": human_size(size),
        "sha256": sha256.hexdigest(),
    }


# ─── API 路由 ─────────────────────────────────────────────

@app.get("/api/files/{path:path}")
@app.get("/api/files")
async def list_files(path: str = ""):
    """列出目录内容"""
    target = safe_path(path) if path else SHARE_ROOT
    if not target.exists():
        raise HTTPException(status_code=404, detail="Directory not found")
    if target.is_file():
        raise HTTPException(status_code=400, detail="Not a directory")
    return dir_tree(target)


@app.post("/api/upload/{path:path}")
@app.post("/api/upload")
async def upload_file(path: str = "", file: UploadFile = File(...)):
    """上传文件到指定目录"""
    # 清理文件名：去掉路径分隔符和 .. 防目录穿越
    clean_name = re.sub(r'[/\\]|^\.{1,2}$', '_', file.filename or 'unnamed')
    clean_name = clean_name[:200]  # 截断超长文件名
    if path:
        dest = safe_path(path) / clean_name
    else:
        dest = SHARE_ROOT / clean_name
    # 最终验证：必须在 SHARE_ROOT 内
    dest_resolved = str(dest.absolute())
    root_resolved = str(SHARE_ROOT.absolute())
    if not dest_resolved.startswith(root_resolved):
        raise HTTPException(status_code=403, detail="Forbidden: path traversal")
    result = await save_upload(file, dest)
    return {"ok": True, **result}


@app.post("/api/mkdir/{path:path}")
async def create_directory(path: str):
    """创建子目录"""
    target = safe_path(path)
    target.mkdir(parents=True, exist_ok=True)
    return {"ok": True, "path": path}


@app.delete("/api/files/{path:path}")
async def delete_file(path: str):
    """删除文件或空目录"""
    target = safe_path(path)
    if not target.exists():
        raise HTTPException(status_code=404, detail="Not found")
    if target.is_dir():
        shutil.rmtree(target)
    else:
        target.unlink()
    return {"ok": True}


# ─── 分享链接 ─────────────────────────────────────────────

@app.post("/api/share")
async def create_share(
    path: str = Form(...),
    expires_hours: int = Form(default=72),
    password: Optional[str] = Form(default=None),
):
    """创建分享链接（带可选密码和过期时间）"""
    if expires_hours < 1:
        raise HTTPException(status_code=400, detail="expires_hours must be >= 1")
    target = safe_path(path)
    if not target.exists():
        raise HTTPException(status_code=404, detail="File not found")

    token = secrets.token_urlsafe(16)
    pwd_hash = hashlib.sha256(password.encode()).hexdigest()[:16] if password else None

    share_tokens[token] = {
        "path": str(target.relative_to(SHARE_ROOT)).replace("\\", "/"),
        "name": target.name,
        "size": target.stat().st_size if target.is_file() else None,
        "created": time.time(),
        "expires": time.time() + expires_hours * 3600,
        "password_hash": pwd_hash,
    }

    return {
        "ok": True,
        "token": token,
        "expires_in": f"{expires_hours}h",
    }


@app.api_route("/api/share/{token}", methods=["GET", "HEAD"])
async def get_share(token: str, password: Optional[str] = Query(default=None), request: Request = None):
    """通过分享令牌访问文件"""
    share = share_tokens.get(token)
    if not share:
        raise HTTPException(status_code=404, detail="Share not found or expired")

    if time.time() > share["expires"]:
        del share_tokens[token]
        raise HTTPException(status_code=410, detail="Share expired")

    if share["password_hash"]:
        if not password:
            raise HTTPException(status_code=401, detail="Password required")
        if hashlib.sha256(password.encode()).hexdigest()[:16] != share["password_hash"]:
            raise HTTPException(status_code=403, detail="Wrong password")

    file_path = SHARE_ROOT / share["path"]
    if not file_path.exists():
        raise HTTPException(status_code=404, detail="File deleted")

    return FileResponse(
        file_path,
        media_type="application/octet-stream",
        headers={
            "Content-Disposition": f'attachment; filename="{share["name"]}"',
        },
    )


@app.get("/api/share/{token}/qr")
async def share_qr(token: str):
    """生成分享链接的 QR 码 SVG"""
    # 检查 token 是否有效
    share = share_tokens.get(token)
    if not share:
        raise HTTPException(status_code=404, detail="Share not found")

    # 构建完整 URL（用当前请求的 host）
    url = f"/s/{token}"

    img = qrcode.make(url, image_factory=qrcode.image.svg.SvgPathImage)
    buf = __import__("io").BytesIO()
    img.save(buf)
    return Response(content=buf.getvalue(), media_type="image/svg+xml")


@app.get("/api/shares")
async def list_shares():
    """列出所有活跃分享"""
    now = time.time()
    active = {}
    for token, info in share_tokens.items():
        if now < info["expires"]:
            active[token] = {
                "path": info["path"],
                "name": info["name"],
                "size": info.get("size"),
                "size_human": human_size(info["size"]) if info.get("size") else "-",
                "expires_at": datetime.fromtimestamp(info["expires"]).isoformat(),
                "expires_in": f"{int((info['expires'] - now) / 3600)}h",
                "has_password": info["password_hash"] is not None,
                "created_at": datetime.fromtimestamp(info["created"]).isoformat(),
            }
    return active


@app.delete("/api/shares/{token}")
async def revoke_share(token: str):
    """撤销分享链接"""
    if token in share_tokens:
        del share_tokens[token]
        return {"ok": True}
    raise HTTPException(status_code=404, detail="Share not found")


@app.get("/api/search")
async def search_files(q: str = Query(..., min_length=1)):
    """按文件名搜索"""
    results = []
    for f in SHARE_ROOT.rglob("*"):
        if f.is_file() and q.lower() in f.name.lower():
            stat = f.stat()
            results.append({
                "name": f.name,
                "path": str(f.relative_to(SHARE_ROOT)).replace("\\", "/"),
                "size": stat.st_size,
                "size_human": human_size(stat.st_size),
                "modified": datetime.fromtimestamp(stat.st_mtime).isoformat(),
                "ext": f.suffix.lower(),
            })
            if len(results) >= 50:
                break
    return results


@app.get("/api/recent")
async def recent_files(limit: int = Query(default=20, le=100)):
    """最近上传/修改的文件"""
    files = []
    for f in SHARE_ROOT.rglob("*"):
        if f.is_file():
            stat = f.stat()
            files.append({
                "name": f.name,
                "path": str(f.relative_to(SHARE_ROOT)).replace("\\", "/"),
                "size": stat.st_size,
                "size_human": human_size(stat.st_size),
                "modified": datetime.fromtimestamp(stat.st_mtime).isoformat(),
                "ext": f.suffix.lower(),
            })
    files.sort(key=lambda x: x["modified"], reverse=True)
    return files[:limit]


@app.get("/api/disk/detail")
async def disk_detail():
    """各目录占用详情"""
    usage = shutil.disk_usage(str(SHARE_ROOT))
    categories = {}
    for child in sorted(SHARE_ROOT.iterdir()):
        if child.is_dir():
            size = sum(f.stat().st_size for f in child.rglob("*") if f.is_file())
            categories[child.name] = {"size": size, "size_human": human_size(size)}
    root_files = sum(f.stat().st_size for f in SHARE_ROOT.iterdir() if f.is_file())
    if root_files:
        categories["(根目录文件)"] = {"size": root_files, "size_human": human_size(root_files)}
    return {
        "total": usage.total,
        "total_human": human_size(usage.total),
        "used": usage.used,
        "used_human": human_size(usage.used),
        "free": usage.free,
        "free_human": human_size(usage.free),
        "warning": usage.free < 15 * 1024**3,
        "categories": categories,
    }


# ─── 磁盘信息 ─────────────────────────────────────────────

@app.get("/api/disk")
async def disk_info():
    """磁盘使用情况"""
    usage = shutil.disk_usage(str(SHARE_ROOT))
    share_size = sum(f.stat().st_size for f in SHARE_ROOT.rglob("*") if f.is_file())
    return {
        "total": human_size(usage.total),
        "used": human_size(usage.used),
        "free": human_size(usage.free),
        "free_bytes": usage.free,
        "share_size": human_size(share_size),
        "warning": usage.free < 15 * 1024**3,  # < 15GB
    }


# ─── 定时清理 ─────────────────────────────────────────────

@app.on_event("startup")
async def start_cleanup():
    """启动时 + 定期清理 tmp/ 过期文件和过期分享"""
    import asyncio

    async def cleanup_loop():
        while True:
            _cleanup_tmp()
            _cleanup_shares()
            await asyncio.sleep(CLEANUP_INTERVAL)

    _cleanup_tmp()
    _cleanup_shares()
    asyncio.create_task(cleanup_loop())


def _cleanup_tmp():
    """删除 tmp/ 下超过 TMP_MAX_AGE_DAYS 天的文件"""
    tmp = SHARE_ROOT / "tmp"
    if not tmp.exists():
        return
    cutoff = time.time() - TMP_MAX_AGE_DAYS * 86400
    for f in tmp.rglob("*"):
        if f.is_file() and f.stat().st_mtime < cutoff:
            f.unlink()
            # 清理空父目录
            if f.parent != tmp and not any(f.parent.iterdir()):
                f.parent.rmdir()


def _cleanup_shares():
    """清理过期分享令牌"""
    now = time.time()
    expired = [t for t, info in share_tokens.items() if now > info["expires"]]
    for t in expired:
        del share_tokens[t]


# ─── 前端路由 ─────────────────────────────────────────────

@app.get("/preview/{path:path}")
async def preview_file(path: str):
    """内联预览文件（不触发下载）"""
    target = safe_path(path)
    if not target.exists() or not target.is_file():
        raise HTTPException(status_code=404, detail="File not found")
    mime, _ = mimetypes.guess_type(str(target))
    return FileResponse(target, media_type=mime or "application/octet-stream", headers={
        "Content-Disposition": f"inline; filename=\"{target.name}\""
    })


@app.get("/", response_class=HTMLResponse)
async def index():
    return (PROJECT_ROOT / "static" / "index.html").read_text(encoding="utf-8")


@app.get("/s/{token}", response_class=HTMLResponse)
async def share_page(token: str):
    """分享链接页面"""
    return (PROJECT_ROOT / "static" / "share.html").read_text(encoding="utf-8")


# 静态文件（CSS/JS 等）
app.mount("/static", StaticFiles(directory=str(PROJECT_ROOT / "static")), name="static")


# ─── 入口 ─────────────────────────────────────────────────

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(
        "server:app",
        host="127.0.0.1",
        port=8766,
        reload=False,
        log_level="info",
    )
