[req]
default_bits = 2048
prompt = no
default_md = sha256
distinguished_name = dn
x509_extensions = v3_req

[dn]
C = CN
ST = State
L = City
O = LAN Share
CN = desktop-hermes

[v3_req]
subjectAltName = @alt_names

[alt_names]
DNS.1 = desktop-hermes
DNS.2 = lanshare.local
DNS.3 = localhost
IP.1 = 127.0.0.1
IP.2 = 192.168.1.100
IP.3 = 10.0.0.1
