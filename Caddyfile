# 局域网与公网入口完全对等，认证统一在应用层（Cookie 会话 / WebDAV Basic）。
# 公网不再设 basic_auth 第一道门（浏览器弹窗体验差）；扫描器与爆破由应用层
# 登录防爆破（按账号 5 次锁 15 分钟）+ 限速（登录 10/分）抵御，见 docs/SECURITY.md。
:80, :8080 {
	# 用户在浏览器输入裸地址（无 https:// 前缀）时兜底跳转
	redir https://{host}:8765{uri} 308
}

# 8801 = 备用隧道（樱花FRP frpc「自动HTTPS」探测口）：Caddy 在此以同一证书
# 直接提供 TLS，frpc 探测到本地即 HTTPS 后保持纯 TCP 透传（与主隧道 35391 同形）。
(lan_common) {	tls C:/lan-share/certs/cert.pem C:/lan-share/certs/key.pem

	# 剥离外部传入的 X-Forwarded-For，防止伪造（后端取 XFF 最后一个值）
	request_header -X-Forwarded-For

	# X-Forwarded-Proto 同样强制覆写（R1-P3-5）：Caddy 默认信任私网来源的
	# XFP 族头，LAN 客户端可注入影响后端 is_https()（Cookie secure 位/二维码）
	request_header X-Forwarded-Proto {scheme}

	# 公网入口标记：默认注入（隧道端口生效）；LAN 站点块再删除同名头。
	# 后端 is_public_entry 以此为可信信号做防爆破分账与 healthz 管控。
	request_header X-LanShare-Entry public

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		-Server
	}

	# /files/* 下载必须走后端鉴权端点（review 2026-09-02 P0-1）：
	# 此前此处直接 file_server 挂整个 SHARE_ROOT，任何登录用户都能越权读取
	# 他人 private/、.trash/.chunks/.zips 与 .meta.db——权限模型被整体绕过。
	# 现在反代到后端 /files/{path} 端点，由 resolve() 按 private/incoming/grants 判权。
	handle /files/* {
		forward_auth localhost:8766 {
			uri /authcheck
		}
		reverse_proxy localhost:8766
	}

	handle /thumb/* {
		# 缩略图内容寻址（服务端 ETag 按 mtime+size），协商缓存省大流量；
		# 必须覆盖上面的全局 no-store，否则浏览器不缓存、时间线每次全量重拉
		header Cache-Control "private, no-cache"
		reverse_proxy localhost:8766
	}

	handle /api/* {
		header Cache-Control "no-cache, no-store, must-revalidate"
		reverse_proxy localhost:8766
	}

	handle /s/* {
		header Cache-Control "no-cache, no-store, must-revalidate"
		reverse_proxy localhost:8766
	}

	handle {
		header Cache-Control "no-cache, no-store, must-revalidate"
		reverse_proxy localhost:8766
	}

	request_body {
		# 25GB：覆盖 WebDAV PUT 的 20GB 上限（MAX_WEBDAV_SIZE，PC 互传挂盘）。
		# 此前 2GB 会把 >2GB 的 DAV 大文件在代理层掐成 413——服务端 20GB
		# 特性从未真正可达；分块上传单块 ≤64MB、直传 ≤2GB 均不受影响
		# （review 2026-09-03 契约一致性）
		max_size 25GB
	}
}

# LAN 主入口：删除客户端自带的公网标记（防伪造，红队 2026-09-06 P1）
:8765 {
	import lan_common
	request_header -X-LanShare-Entry
}

# 隧道入口访问日志（F4 流量仪表）：只挂隧道/备用块——"有日志 ≡ 走隧道 ≡
# 消耗樱花FRP 配额"，判别零歧义；LAN 直连 :8765 不产生日志。
# 解析方 app/services/traffic.py 只读 glob access.log*；roll 5×10MiB 封顶 50MiB。
(tunnel_log) {
	log {
		output file C:/lan-share/data/logs/access/access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}

# 隧道/备用入口：注入公网标记（Host 头客户端可伪造，物理端口才是可信信号；
# 后端 is_public_entry 据此分账：公网失败只锁公网侧 + healthz 不对公网暴露）
:8767, :443, :8801 {
	import lan_common
	import tunnel_log
}

